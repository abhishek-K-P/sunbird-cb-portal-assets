{
  "mainHeading": "Reusable User Groups",
  "createButton": {
    "label": "Create user group",
    "allowedRoles": ["mdo_admin", "mdo_leader"]
  },
  "roleBanner": {
    "icon": "check",
    "roles": [
      {
        "role": "mdo_leader",
        "title": "Acting as MDO Leader",
        "description": "You can create and manage all user groups within the organisation."
      },
      {
        "role": "mdo_admin",
        "title": "Acting as MDO Admin",
        "description": "You can create user groups and edit the conditions of groups you have created."
      }
    ],
    "default": {
      "title": "Viewing user groups",
      "description": "You can use existing groups. Creating groups and editing conditions needs an MDO Admin or MDO Leader role."
    }
  },
  "search": {
    "filters": {},
    "sortBy": "updateddate",
    "sortOrder": "desc"
  },
  "table": {
    "columns": [
      { "key": "name", "displayName": "Group name", "type": "title", "sortable": true, "sortField": "usergroupname" },
      { "key": "estimatedOfficers", "displayName": "Estimated officers", "type": "reach" },
      { "key": "owner", "displayName": "Owner", "type": "owner" },
      { "key": "actions", "displayName": "Actions", "type": "actions" }
    ],
    "reachAction": { "key": "reach", "label": "Check reach", "icon": "person_outline" },
    "rowActions": [ 
      { "enabled": true, "key": "edit", "label": "Edit", "icon": "edit", "allowedRoles": ["mdo_admin", "mdo_leader"], "ownerOnlyRoles": ["mdo_admin"], "disabledTooltip": "Only an MDO Leader can edit the conditions of a user group created by another user." },
      { "enabled": true, "key": "copy", "label": "Copy", "icon": "content_copy" },
      { "enabled": true, "key": "use", "label": "Use" },
      { "enabled": true, "key": "delete", "label": "Delete", "icon": "delete_outline", "allowedRoles": ["mdo_admin", "mdo_leader"], "ownerOnlyRoles": ["mdo_admin"], "disabledTooltip": "Only an MDO Leader can delete a user group created by another user." }
    ],
    "conditionLabel": { "singular": "condition", "plural": "conditions" },
    "emptyStateText": "No user groups created yet.",
    "pageSize": 20,
    "pageSizeOptions": [20, 50, 100]
  },

